# Copy this file to .env and fill in your own values.

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Postgres connection string. Matches the default docker-compose.yml service.
DATABASE_URL=postgresql://voiceapp:voiceapp@localhost:5432/voice_meeting_assistant

# --- Optional tuning ---

# faster-whisper model size: tiny | base | small | medium | large-v3
# "base" is CPU-friendly and a good default; "small" is more accurate but slower.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Claude model used for summarization + action item extraction.
CLAUDE_MODEL=claude-sonnet-5

# Directory where uploaded audio files are stored.
UPLOAD_DIR=uploads

# Max upload size in bytes (default 200 MB).
MAX_UPLOAD_BYTES=209715200
